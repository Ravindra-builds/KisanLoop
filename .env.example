# ==============================================================================
# KISANLOOP ENVIRONMENT CONFIGURATION
# ==============================================================================
# Single control variable:
# DEMO_MODE=true  -> Runs in offline/demo mode (mock storage, simulated telemetry, direct portal access)
# DEMO_MODE=false -> Runs in production mode (requires authentication, real DB/APIs if configured)
DEMO_MODE=true
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + PostGIS / Neon)
# ------------------------------------------------------------------------------
# Example: postgres://username:password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/kisanloop?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. CACHE & RATE LIMITING (Upstash Redis)
# ------------------------------------------------------------------------------
# Example: https://cool-tiger-12345.upstash.io
REDIS_URL=
REDIS_TOKEN=

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE (Qdrant Cloud / Local)
# ------------------------------------------------------------------------------
# Example: https://xyz-example.eu-central.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION (Clerk)
# ------------------------------------------------------------------------------
# Obtain from Clerk Dashboard (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ------------------------------------------------------------------------------
# 5. AI PROVIDER CONFIGURATION (Vercel AI SDK)
# ------------------------------------------------------------------------------
# Options: 'google' | 'openai' | 'demo'
AI_PROVIDER=google
AI_MODEL=gemini-1.5-flash

# Google Gemini API Key (https://aistudio.google.com/)
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 6. COMPUTER VISION & CROP DIAGNOSIS
# ------------------------------------------------------------------------------
# Options: 'google' | 'openai' | 'demo'
VISION_PROVIDER=google
VISION_API_KEY=

# ------------------------------------------------------------------------------
# 7. SPEECH (Speech-to-Text & Text-to-Speech)
# ------------------------------------------------------------------------------
# Options: 'web' | 'elevenlabs' | 'demo'
STT_PROVIDER=web
STT_API_KEY=
TTS_PROVIDER=web
TTS_API_KEY=

# ------------------------------------------------------------------------------
# 8. AGRICULTURAL TELEMETRY PROVIDERS
# ------------------------------------------------------------------------------
# Weather: 'demo' | 'openweather'
WEATHER_PROVIDER=demo
WEATHER_API_KEY=

# Soil & Satellite: 'demo' | 'copernicus' | 'soilgrids'
SOIL_PROVIDER=demo
SOIL_API_KEY=
SATELLITE_PROVIDER=demo
SATELLITE_API_KEY=

# ------------------------------------------------------------------------------
# 9. OBJECT STORAGE (Cloudflare R2 / S3 Compatible)
# ------------------------------------------------------------------------------
# When empty, uploads are stored in public/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ------------------------------------------------------------------------------
# 10. BACKGROUND WORKFLOWS (Inngest)
# ------------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
